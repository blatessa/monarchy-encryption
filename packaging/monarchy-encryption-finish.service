# Installed as /usr/lib/systemd/system/monarchy-encryption-finish.service. Enabled by setup (a link in
# /etc/systemd/system/multi-user.target.wants), it runs once at the next start: the TPM bound to Secure Boot, the
# passphrase and setup's one-time unlock removed. It removes its own link. Why: docs/dev/architecture.md, "TPM unlock".
[Unit]
Description=Finish disk encryption setup (TPM unlock bound to Secure Boot)
After=tpm2.target local-fs.target
Wants=tpm2.target

[Service]
Type=oneshot
ExecStart=/usr/bin/monarchy-encryption finish

[Install]
WantedBy=multi-user.target
