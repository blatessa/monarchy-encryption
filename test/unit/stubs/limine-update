#!/bin/bash
# Stand-in for limine-update (limine-mkinitcpio-hook 1.40, as observed in the lab: docs/dev/findings.md):
# limine-install copies a plain Limine to the binary and the fallback path; limine-mkinitcpio builds the boot image;
# then the post hooks run in name order, Limine's own 90-limine-enroll-config among them: it enrolls the menu's
# checksum (only if /etc/default/limine says so), so hooks named before it can still change the menu and those after it
# see the enrolled Limine.
echo "limine-update $*" >> "$STUB_LOG"
[[ -z ${STUB_LIMINE_UPDATE_FAIL:-} ]] || { echo "ERROR: Failed to build the UKI." >&2; exit 1; }
esp=$MONARCHY_ENCRYPTION_ESP etc=$MONARCHY_ENCRYPTION_ETC
cp "$STUB_STATE/limine-stock.efi" "$esp/EFI/BOOT/BOOTX64.EFI"
cp "$STUB_STATE/limine-stock.efi" "$esp/EFI/limine/limine_x64.efi"
echo "boot image $RANDOM$RANDOM" > "$esp/EFI/Linux/omarchy_linux-omarchy.efi"
enroll_config() {
  if grep -qx 'ENABLE_ENROLL_LIMINE_CONFIG=yes' "$etc/default/limine"; then
    echo "enrolled $(b2sum "$esp/limine.conf" | cut -d' ' -f1)" >> "$esp/EFI/limine/limine_x64.efi"
  fi
}
enrolled=0
for h in "$etc"/boot/hooks/post.d/*; do
  if ((!enrolled)) && [[ ${h##*/} > 90-limine-enroll-config ]]; then enroll_config; enrolled=1; fi
  [[ -f $h && -x $h && $h != *.disabled ]] && "$h"
done
((enrolled)) || enroll_config
exit 0
