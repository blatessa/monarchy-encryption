#!/bin/bash
# Stand-in for cryptsetup 2.8 (output as seen in the lab: docs/dev/findings.md). The disk is /dev/vda2 mapped as
# "root"; STUB_NOT_LUKS=1: nothing is mapped. Its keyslots are $STUB_STATE/keyslots (see the systemd-cryptenroll stub).
# STUB_RECOVERY_KEY_BROKEN=1: a recovery key doesn't open the disk although it was enrolled. A TPM slot whose secret
# is "stale" no longer matches the firmware (PCR 7 changed); "-" is one that does.
echo "cryptsetup $*" >> "$STUB_LOG"
ks=$STUB_STATE/keyslots
case $1 in
  status)
    [[ -z ${STUB_NOT_LUKS:-} && $2 == root ]] || { echo "/dev/mapper/$2 is inactive."; exit 4; }
    printf '/dev/mapper/root is active and is in use.\n  type:    LUKS2\n  cipher:  aes-xts-plain64\n  device:  /dev/vda2\n' ;;
  luksUUID) [[ $2 == /dev/vda2 ]] && echo 8b81edbd-cf38-4664-82ab-17852814fdb0 ;;
  luksDump)   # --dump-json-metadata: keyslots and the tokens systemd-cryptenroll adds (none for a passphrase)
    while read -r s t _; do echo "$s $t $(cat "$STUB_STATE/tpm2-pcrs-$s" 2>/dev/null | tr '+' ',')"; done <"$ks" |
      jq -Rn '[inputs | split(" ")] |
      {keyslots: (map({key: .[0], value: {type: "luks2"}}) | from_entries),
       tokens: (map(select(.[1] != "password")) | to_entries |
         map({key: (.key | tostring), value: ({type: ("systemd-" + .value[1]), keyslots: [.value[0]]} +
           if .value[1] == "tpm2" then {"tpm2-pcrs": (.value[2] | split(",") | map(select(. != "") | tonumber))} else {} end)})
         | from_entries)}' ;;
  luksAddKey)   # luksAddKey (--token-only --token-type systemd-tpm2 | --key-file=FILE) DEVICE NEWKEYFILE
    new=$(cat "${!#}")
    if [[ " $* " == *" --token-only "* ]]; then
      [[ -z ${STUB_TPM_UNLOCK_FAIL:-} ]] && grep -q '^[0-9]* tpm2 -$' "$ks" || { echo "No usable token is available." >&2; exit 1; }
    else
      for a in "$@"; do [[ $a == --key-file=* ]] && kf=${a#*=}; done
      secret=$(cat "${kf:-/dev/null}")
      awk -v k="$secret" '$3 == k {f=1} END {exit !f}' "$ks" || { echo "No key available with this passphrase." >&2; exit 2; }
    fi
    slot=0; while grep -q "^$slot " "$ks"; do slot=$((slot + 1)); done
    echo "$slot password $new" >> "$ks"; echo "Key slot $slot created." ;;
  open)   # open --test-passphrase --token-only --token-type systemd-tpm2 DEVICE: the TPM opens it
    if [[ " $* " == *" --token-only "* ]]; then
      [[ -z ${STUB_TPM_UNLOCK_FAIL:-} ]] && grep -q '^[0-9]* tpm2 -$' "$ks" || { echo "No usable token is available." >&2; exit 1; }
      echo "Key slot $(awk '$2 == "tpm2" && $3 == "-" {print $1; exit}' "$ks") unlocked."; exit 0
    fi
    # open --test-passphrase [--disable-external-tokens] --key-file=- [--key-slot=N] DEVICE
    secret=$(cat) slot=""
    # without --disable-external-tokens, a TPM that opens the disk wins whatever the key (as cryptsetup 2.8 does)
    if [[ " $* " != *" --disable-external-tokens "* && " $* " != *" --key-slot="* && -z ${STUB_TPM_UNLOCK_FAIL:-} ]] &&
      grep -q '^[0-9]* tpm2 -$' "$ks"; then exit 0; fi
    for a in "$@"; do [[ $a == --key-slot=* ]] && slot=${a#*=}; done
    if [[ -n ${STUB_RECOVERY_KEY_BROKEN:-} ]] && grep -q "^[0-9]* recovery $secret$" "$ks"; then
      echo "No key available with this passphrase." >&2; exit 2
    fi
    awk -v k="$secret" -v s="$slot" '$3 == k && (s == "" || $1 == s) {f=1} END {exit !f}' "$ks" ||
      { echo "No key available with this passphrase." >&2; exit 2; } ;;
esac
exit 0
