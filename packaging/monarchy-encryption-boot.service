# Installed as /usr/lib/systemd/system/monarchy-encryption-boot.service. Enabled by setup (a link in
# /etc/systemd/system/multi-user.target.wants), it runs at every start: the TPM policy is made for the boot files that
# started, and at the start after setup, the TPM is bound to it and the passphrase and setup's one-time unlock are
# removed. release removes the link. Why: docs/dev/architecture.md, "TPM unlock".
[Unit]
Description=Keep disk encryption's TPM policy matching the boot files that started
After=tpm2.target local-fs.target
Wants=tpm2.target

[Service]
Type=oneshot
ExecStart=/usr/bin/monarchy-encryption boot

[Install]
WantedBy=multi-user.target
